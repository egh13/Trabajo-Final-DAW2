// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(CLIENT)
  createdAt DateTime @default(now())
    orders    Order[]
  cartItems CartItem[]
  logs      UserLog[]
}

enum Role {
  CLIENT
  ADMIN
  ANALYST
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  description String?  @db.Text // Añadido: Para descripciones largas en MariaDB
  price       Float
  stock       Int
  image       String?
  categoryId  Int
  category    Category @relation(fields: [categoryId], references: [id])
  orderItems  OrderItem[]
  cartItems   CartItem[]
  createdAt   DateTime @default(now())
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  products    Product[]
}

model Order {
  id        Int         @id @default(autoincrement())
  userId    Int
  user      User        @relation(fields: [userId], references: [id])
  total     Float
  status    String      @default("pending")
  items     OrderItem[]
  createdAt DateTime    @default(now())
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  order     Order   @relation(fields: [orderId], references: [id])
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
}

model UserLog {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  level     LogLevel @default(INFO)
  module    String
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  ip        String?
  detail    String?  @db.Text
}

enum LogLevel {
  INFO
  WARNING
  ERROR
  DEBUG
}

model CartItem {
  id        Int      @id @default(autoincrement())
  sessionId String
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id])
  productId Int
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  createdAt DateTime @default(now())

  @@unique([sessionId, productId])
}

model IpBlock {
  id        Int       @id @default(autoincrement())
  ip        String?
  userId    Int?
  email     String?
  reason    String
  manual    Boolean   @default(false)
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@index([ip])
  @@index([userId])
  @@index([email])
}

