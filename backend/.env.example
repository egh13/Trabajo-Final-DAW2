# Puerto para desplegar el servidor (3000 por defecto)
PORT=3000

# Entorno de desarrollo (Para ver errores)
NODE_ENV=development

# JWT tokens config
JWT_SECRET=cambia_este_secreto_en_produccion
JWT_EXPIRES_IN=24h

# DB config
DATABASE_URL=mysql://username:password@mariadb:3306/mydb

# SMTP config para envío de correos
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu-email@gmail.com
SMTP_PASS=tu-app-password

# URL del frontend (para enlaces en correos)
FRONTEND_URL=http://localhost:5173